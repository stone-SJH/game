# Copy to D:\game\runtime\config\worker.env.ps1 and restrict its ACL.
$env:CONTROL_URL = 'https://controller.example.com'
$env:WORKER_ID = 'yahahagame-sandbox-0'
$env:WORKER_TOKEN = 'REPLACE_WITH_PER_WORKER_ENROLLMENT_TOKEN'
$env:YAHAHAGAME_WORKER_ROOT = 'D:\game\runtime'
$env:BLENDER_EXE = 'D:\Tools\Blender\blender-5.2.1-windows-x64\blender.exe'
$env:UNREAL_CMD = 'D:\UE\UE_5.8\Engine\Binaries\Win64\UnrealEditor-Cmd.exe'
$env:RUN_UAT = 'D:\UE\UE_5.8\Engine\Build\BatchFiles\RunUAT.bat'
$env:SEVEN_ZIP_EXE = 'C:\Program Files\7-Zip\7z.exe'
# npm shims are resolved to their package entrypoint; an explicit .js or .exe also works.
$env:CODEX_CMD = 'codex.cmd'
$env:CODEX_TIMEOUT_MS = '14400000'
$env:CODEX_RETRY_DELAY_MS = '10000'
# 0 means retry until the task deadline, cancellation, or an explicit hard failure.
$env:CODEX_MAX_ATTEMPTS = '0'
$env:POLL_INTERVAL_MS = '2000'
