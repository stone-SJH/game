[Unit]
Description=YahahaGame Controller phase-1 HTTP control plane
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=yahahagame-controller
Group=yahahagame-controller
WorkingDirectory=/opt/yahahagame-controller/controller
EnvironmentFile=/opt/yahahagame-controller/config/controller.env
ExecStart=/usr/bin/node /opt/yahahagame-controller/controller/api/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yahahagame-controller

[Install]
WantedBy=multi-user.target
