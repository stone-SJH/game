NODE_ENV=phase1
PORT=8080
BIND=127.0.0.1
PUBLIC_ORIGIN=https://controller.example.com
APP_ROOT=/opt/yahahagame-controller/app
DATABASE_URL=postgresql://yahahagame:<CHANGE_ME>@127.0.0.1:5432/yahahagame_controller
ARTIFACT_ROOT=/var/lib/yahahagame-controller/artifacts
MAX_USERS=10
